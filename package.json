{
  "name": "hotel-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack hotel room booking system with date-overlap availability engine (MERN)",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "start:server": "npm run start --prefix server",
    "build:client": "npm run build --prefix client",
    "test:server": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
